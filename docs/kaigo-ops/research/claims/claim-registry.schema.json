{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Josh-Temple/kaigo-rules/docs/kaigo-ops/research/claims/claim-registry.schema.json",
  "title": "Kaigo Ops Claim Registry",
  "type": "object",
  "required": [
    "format_version",
    "created_at",
    "claims"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "created_at": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "issue_id",
          "subtopic",
          "statement",
          "service_scope",
          "answerability",
          "verification_status",
          "source_node_ids",
          "source_ids",
          "boundaries",
          "reviewed_at"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "subtopic": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "service_scope": {
            "type": "string",
            "minLength": 1
          },
          "answerability": {
            "enum": [
              "ANSWER",
              "PARTIAL",
              "REVIEW_REQUIRED",
              "LOCAL",
              "OUT_OF_SCOPE"
            ]
          },
          "verification_status": {
            "enum": [
              "VERIFIED_CURRENT",
              "VERIFIED_SOURCE_TEXT",
              "VERIFIED_WITH_SOURCE_LIMITATION",
              "VERIFIED_INTERPRETATION",
              "CANDIDATE_UNREVIEWED",
              "REVIEW_REQUIRED",
              "LOCAL_DEPENDENT",
              "OUT_OF_SCOPE"
            ]
          },
          "source_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "candidate_qa_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_note": {
            "type": "string"
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "routing": {
            "type": "object",
            "required": [
              "required_groups"
            ],
            "properties": {
              "required_groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "excluded_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "fallback_guard_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "service_scope": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

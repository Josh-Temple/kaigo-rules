  "classification_definitions": {
    "INDIVIDUAL_SERVICE": "Q&A service code representing one current service category. Existing Kaigo Rules service IDs are mapped; missing catalog entries remain pending for Chat A/Integrator reconciliation.",
    "SHARED_COMMON_CATEGORY": "Q&A scope shared across a service group. It is represented as a group relation and is not copied into individual services.",
    "HISTORICAL_ABOLISHED_SERVICE": "Historical or abolished service classification retained for search and provenance, outside the current-service catalog.",
    "REMUNERATION_ONLY_THEME": "Cross-service remuneration theme rather than an individual service.",
    "OTHER_SPECIAL": "Special benefit/program classification that must not be forced into an individual service ID."
  },
  "query_contract": {
    "direct_individual_service": "Use the exact service_code relation after catalog mapping is resolved.",
    "shared_common_category": "Resolve through data/qa-group-relations.json explicit group membership. Treat the group relation as search scope only; row-level current_service_scope and qualified raw labels remain separate applicability constraints.",
    "qualified_raw_service_label": "When a corpus row's raw service_label differs from the canonical code label, preserve that row-level qualifier and fail closed unless an explicit parser/review establishes the narrower or composite scope.",
    "current_service_scope": "Preserve as source data when present; it must not overwrite the primary service_code mapping.",
    "historical_or_special": "Expose through their own taxonomy facet; do not attach to current services automatically."
  },
